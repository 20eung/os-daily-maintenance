# ─────────────────────────────────────────────────────────
# macOS 전용 설정 예시 (.env.darwin.sample)
# .env 이후 로드되며, 同名 설정을 덮어씁니다.
# 복사 후 .env.darwin 으로 이름 변경하여 사용
#
# 주의: Linux(OCI) 와 통일하기 위해 프로젝트 루트는 ~/Project (대문자 P) 사용.
#      OCI 측은 `mv ~/project ~/Project` 으로 마이그레이션.
# ─────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────
# 기본 경로
# ─────────────────────────────────────────────────────────
# 사용자의 홈 디렉토리 경로 (자동: $HOME)
# MAINTENANCE_HOME="/Users/YOUR_NAME"

# macOS 전용 바이너리 경로 (Homebrew 포함) — 기본값으로 충분
# MAINTENANCE_PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin"

# Conda (Miniconda/Anaconda) 초기화 셸 경로
# MAINTENANCE_CONDA_SH="/opt/homebrew/Caskroom/miniconda/base/etc/profile.d/conda.sh"

# ─────────────────────────────────────────────────────────
# 프로젝트 디렉토리 설정 (Linux 와 통일: 대문자 P)
# ─────────────────────────────────────────────────────────
# 프로젝트들이 모여 있는 상위 디렉토리
USER_PROJECT_DIR="$HOME/Project"

# 여러 프로젝트 상위 디렉토리를 탐색하고 싶을 때 (공백 구분)
# USER_PROJECT_DIRS="$HOME/Project $HOME/Work"

# Obsidian-Wiki 경로 (선택)
# OBSIDIAN_WIKI_DIR="$HOME/Project/Obsidian-Wiki"

# 로그파일 저장 경로
# LOG_STAGING_DIR="$HOME/Project/os-daily-maintenance/logs"

# 로그 보관 기간 (일 단위, 기본값: 30)
LOG_RETENTION_DAYS=7

# ─────────────────────────────────────────────────────────
# 패키지 관리
# ─────────────────────────────────────────────────────────
# 우선적으로 업데이트를 확인할 pip 패키지 목록 (공백 구분)
#   - 비워두면 pip3 list --outdated 결과 전체를 사용
#   - PEP 668(Homebrew python) 환경에서는 --user 로 자동 격리
PIP_TARGET_PACKAGES="pandas numpy requests"

# ─────────────────────────────────────────────────────────
# Docker
# ─────────────────────────────────────────────────────────
# 우선적으로 pull을 시도할 docker 이미지 목록 (아키텍처 확인 필요)
#   - 참고: 섹션 10 에서 compose 라벨 기반으로 자동 처리되므로 보통 비워둠
DOCKER_TARGET_IMAGES="nginx:alpine mysql:latest"

# ─────────────────────────────────────────────────────────
# System Monitoring Thresholds (선택)
# ─────────────────────────────────────────────────────────
# CPU_TEMP_THRESHOLD=80
# DISK_TEMP_THRESHOLD=55
# DISK_USAGE_THRESHOLD=80
# MEMORY_USAGE_THRESHOLD=85

# ─────────────────────────────────────────────────────────
# Hermes Agent (선택, macOS 는 launchctl 이지만 호환을 위해 환경만 노출)
# ─────────────────────────────────────────────────────────
# macOS 에서는 systemd 가 없으므로 MAINTENANCE_HERMES_UNITS 는 무시됩니다.
# Hermes 자체는 `hermes update` 만 실행됩니다.
# MAINTENANCE_HERMES_UNITS=""

# ─────────────────────────────────────────────────────────
# Telegram (synced from ~/.hermes/.env on 호스트)
# ─────────────────────────────────────────────────────────
# MAINTENANCE_BOT_KEY="YOUR_BOT_TOKEN_HERE"
# MAINTENANCE_CHAT_ID="YOUR_CHAT_ID_HERE"
